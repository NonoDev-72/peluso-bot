# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Debe coincidir con una Redirect URI configurada en el portal de Discord
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# Path bajo el cual se sirve el panel detras del proxy reverso (vacio = raiz del dominio, recomendado)
WEB_BASE_PATH=

# Base de datos compartida entre el bot y el panel web
# En Docker/Dokploy usar una ruta absoluta dentro del volumen compartido, ej: sqlite:////data/peluso.db
DATABASE_URL=sqlite:///./peluso.db

# Clave para firmar las cookies de sesion del panel web (generar una propia)
WEB_SECRET_KEY=change-me

# IDs de Discord (separados por coma) con acceso al panel sin importar roles de servidor
BOT_OWNER_IDS=
